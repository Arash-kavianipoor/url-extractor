{
  "manifest_version": 3,
  "name": "Web Scraper & Offline Extractor Pro",
  "short_name": "WebScraperPro",
  "version": "1.0.0",
  "description": "استخراج ۱۰۰٪ محلی لینک‌ها، تیترها (H1-H6)، خروجی CSV/JSON و دانلود بسته آفلاین بدون محدودیت سرور و خطای ۵۰۳",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Scraper & Offline Extractor Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-scraper-offline@extractor.local",
      "strict_min_version": "109.0"
    }
  }
}